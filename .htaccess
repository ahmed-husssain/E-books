# Protect sensitive database dumps, environment configs, logs, and backups
<FilesMatch "\.(sql|env|log|bak|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect database directory and normalize upload paths
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database/ - [F,L]
    RewriteRule ^[Uu]ploads/[Ii]mages/(.*)$ uploads/Images/$1 [L,NC]
</IfModule>
