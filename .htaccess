# Disable directory browsing
Options -Indexes

# Block access to database dumps, environment configs, logs, and backups
<FilesMatch "(?i)\.(sql|env|log|bak|ini|sh|git.*)$">
    Require all denied
</FilesMatch>

# Block direct access to database directory and hidden dotfiles
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database/ - [F,L]
    RewriteRule (^\.|/\.) - [F]
</IfModule>

# Enforce secure PHP session cookie defaults
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.use_only_cookies 1
    php_value session.cookie_samesite "Lax"
</IfModule>
<IfModule mod_php7.c>
    php_value session.cookie_httponly 1
    php_value session.use_only_cookies 1
    php_value session.cookie_samesite "Lax"
</IfModule>
<IfModule mod_php8.c>
    php_value session.cookie_httponly 1
    php_value session.use_only_cookies 1
    php_value session.cookie_samesite "Lax"
</IfModule>
